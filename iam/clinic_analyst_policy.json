
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListClinic1CuratedData",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::marrowick-maha-5506-652122431950-tenant1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "curated",
            "curated/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadClinic1CuratedData",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::marrowick-maha-5506-652122431950-tenant1/curated/*"
    }
  ]
}
